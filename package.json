{
	"name": "fugu-react",
	"version": "0.1.0",
	"private": true,
	"scripts": {
  "dev": "next dev",
  "build": "next build",
  "start": "next start",
  "export": "next export",
  "lint": "next lint --max-warnings=0",
  "test": "jest --ci --reporters=default --reporters=jest-junit",
  "test:watch": "jest --watch",
  "test:integration": "jest \"components/**/*.integration.test.js\"",
  "integration-test": "jest \"components/**/*.integration.test.js\"",
  "test:unit": "jest \"components/**/*.unit.test.js\""
},
	"dependencies": {
	  "@fortawesome/fontawesome-svg-core": "^6.5.1",
	  "@fortawesome/free-regular-svg-icons": "^6.5.1",
	  "@fortawesome/free-solid-svg-icons": "^6.5.1",
	  "@fortawesome/react-fontawesome": "^0.2.1",
	  "bootstrap": "^5.3.2",
	  "google-map-react": "^2.2.0",
	  "isotope-layout": "^3.0.6",
	  "next": "^15.3.1",
	  "react": "^18.2.0",
	  "react-bootstrap": "^2.9.2",
	  "react-countdown": "^2.3.5",
	  "react-countup": "^6.5.1",
	  "react-dom": "^18.2.0",
	  "react-hook-form": "^7.49.0",
	  "react-modal-video": "^1.2.10",
	  "react-router-dom": "^6.30.0",
	  "react-slick": "^0.29.0",
	  "slick-carousel": "^1.8.1",
	  "swiper": "^11.1.0",
	  "uuid": "^9.0.1"
	},
	"devDependencies": {
	  "@testing-library/jest-dom": "^6.6.3",
	  "@testing-library/react": "^15.0.6",
	  "babel-jest": "^29.7.0",
	  "eslint": "^8.56.0",
	  "eslint-config-next": "13.3.0",
	  "jest": "^29.7.0",
	  "jest-environment-jsdom": "^29.7.0",
	  "jest-junit": "^16.0.0"
	},
	"jest": {
	  "testEnvironment": "jsdom",
	  "setupFilesAfterEnv": [
		"<rootDir>/jest.setup.js"
	  ],
	  "testPathIgnorePatterns": [
		"/node_modules/",
		"/.next/"
	  ],
	  "transform": {
		"^.+\\.(js|jsx|ts|tsx|mjs)$": [
		  "babel-jest",
		  {
			"presets": [
			  "next/babel"
			]
		  }
		]
	  },
	  "transformIgnorePatterns": [
		"/node_modules/(?!(swiper|react-slick|slick-carousel|ssr-window|dom7)/)"
	  ],
	  "moduleNameMapper": {
		"\\.(css|less|scss|sass)$": "<rootDir>/__mocks__/styleMock.js",
		"^swiper/css$": "<rootDir>/__mocks__/styleMock.js",
		"^swiper/css/.*$": "<rootDir>/__mocks__/styleMock.js"
	  }
	}
  }
  